# --- LLM: pick ONE provider, fill in only its key ---
LLM_PROVIDER=openai          # anthropic | openai | gemini
LLM_MODEL=gpt-4o-mini        # optional, e.g. gpt-4o-mini / gemini-1.5-flash / claude-3-5-sonnet

ANTHROPIC_API_KEY=your_anthropic_api_key_here     # needed if LLM_PROVIDER=anthropic
OPENAI_API_KEY=your_openai_api_key_here           # needed if LLM_PROVIDER=openai
GOOGLE_API_KEY=your_google_api_key_here           # needed if LLM_PROVIDER=gemini

# --- Hosted vector DB (Qdrant Cloud: https://cloud.qdrant.io, free tier available) ---
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=pdf_knowledge_base_openai_1536

# --- GitHub MCP (fine-grained or classic PAT with the scopes you want the agent to have) ---
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# --- Google Calendar MCP (OAuth "Desktop app" credentials JSON from Google Cloud Console) ---
GOOGLE_OAUTH_CREDENTIALS=/path/to/gcp-oauth.keys.json

# --- Misc ---
DEFAULT_TIMEZONE=UTC
